# Ignore everything
**

!/go.mod
!/go.sum

# Include CD
!/cd/go.mod
!/cd/go.sum
!/cd/*.go
!/cd/program
!/cd/program/**

# Include providers
!/provider
!/provider/**

# Include Go SDK
!/sdk
!/sdk/v2
!/sdk/v2/**

# Prebuilt binaries for --build-arg BINARIES=prebuilt (make image_binaries)
!/bin
!/bin/image
!/bin/image/**
